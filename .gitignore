## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ---------------------------------------------------------------
# Visual Studio / IDEs
# ---------------------------------------------------------------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
.vscode/
!.vscode/extensions.json
.idea/
*.DotSettings.user

# Publish output and Azure publish profiles (they can contain credentials)
[Pp]ublish/
PublishProfiles/
*.pubxml
*.pubxml.user
*.publishproj
*.azurePubxml

# ---------------------------------------------------------------
# Secrets & local configuration (never commit these)
# Real connection strings live in user-secrets (dev) or Azure App Service settings (prod).
# ---------------------------------------------------------------
.env.*
secrets.json
appsettings.*.local.json
appsettings.Local.json
*.pfx
*.p12

# ---------------------------------------------------------------
# Local data
# ---------------------------------------------------------------
# Local drone image storage fallback (used when no blob storage is configured)
**/App_Data/
# SQLite / SQL Server local database files
*.db
*.db-shm
*.db-wal
*.mdf
*.ldf
# Azurite (local Azure Storage emulator) data
__azurite_db_*.json
__blobstorage__/
__queuestorage__/
.azurite/

# ---------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------
node_modules/
# Claude Code worktrees and local settings
.claude/worktrees/
.claude/settings.local.json
# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
