@model DroneImage
@{
    ViewData["Title"] = "Add drone image";
    var field = (Field)ViewBag.Field;
    var devices = (List<SelectListItem>)ViewBag.Devices;
}

<div class="row"><div class="col-md-7">
    <h1 class="h3 mb-1">Add drone image</h1>
    <p class="text-muted">Field: @field.Name (@field.Farm?.Name)</p>
    <form asp-action="AddDroneImage" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="FieldId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="DeviceId" class="form-label"></label>
            <select asp-for="DeviceId" asp-items="devices" class="form-select">
                <option value="">— Not recorded —</option>
            </select>
            <span asp-validation-for="DeviceId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label for="photo" class="form-label">Drone photo</label>
            <input type="file" id="photo" name="photo" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
            <div class="form-text">JPG, PNG, WebP or GIF up to 10 MB. Stored securely in Azure Blob Storage.</div>
            <span class="text-danger">@Html.ValidationMessage("photo")</span>
        </div>
        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label">…or link to an image hosted elsewhere</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="https://…" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col mb-3">
                <label asp-for="CapturedAt" class="form-label"></label>
                <input asp-for="CapturedAt" class="form-control" />
                <span asp-validation-for="CapturedAt" class="text-danger"></span>
            </div>
            <div class="col mb-3">
                <label asp-for="Ndvi" class="form-label"></label>
                <input asp-for="Ndvi" class="form-control" step="0.001" />
                <div class="form-text">Optional, between -1 and 1.</div>
                <span asp-validation-for="Ndvi" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">Save image</button>
        <a class="btn btn-link" asp-controller="Fields" asp-action="Details" asp-route-id="@field.Id">Cancel</a>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
