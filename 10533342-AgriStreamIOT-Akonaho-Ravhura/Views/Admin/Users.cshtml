@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Users";
    var filter = ViewBag.RoleFilter as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users @(filter != null ? $"({AppRoles.DisplayName(filter)})" : "")</h1>
    <a class="btn btn-success" asp-action="CreateUser">Create user</a>
</div>

<div class="mb-3">
    <a class="btn btn-sm @(filter == null ? "btn-dark" : "btn-outline-dark")" asp-action="Users">All</a>
    @foreach (var r in AppRoles.All)
    {
        <a class="btn btn-sm @(filter == r ? "btn-dark" : "btn-outline-dark")" asp-action="Users" asp-route-role="@r">@AppRoles.DisplayName(r)</a>
    }
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead><tr><th>Name</th><th>Email</th><th>User type</th><th>Farms</th><th>Created</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td><span class="badge bg-secondary">@AppRoles.DisplayName(u.Role)</span></td>
            <td>@(u.Role == AppRoles.Admin ? "—" : u.FarmCount.ToString())</td>
            <td>@u.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="EditUser" asp-route-id="@u.Id">Edit</a>
                <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete @u.FullName?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="6" class="text-center text-muted">No users found.</td></tr>
    }
    </tbody>
</table>
</div>
