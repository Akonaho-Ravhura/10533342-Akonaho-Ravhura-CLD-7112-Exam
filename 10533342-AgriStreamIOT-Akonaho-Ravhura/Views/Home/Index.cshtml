@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="eyebrow mb-3">Precision agriculture · IoT</div>
    <h1>Soil, sky and sensors.<br /><span class="glow-text">One clear view.</span></h1>
    <p class="lead">AgriStream turns soil sensor, humidity and drone data from your fields into crop health and yield decisions.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-orange btn-lg px-4" asp-controller="Account" asp-action="Dashboard">Go to my dashboard</a>
    }
    else
    {
        <a class="btn btn-orange btn-lg px-4 me-2" asp-controller="Account" asp-action="Register">Create account</a>
        <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="Account" asp-action="Login">Log in</a>
    }
</section>

<div class="row g-3">
    <div class="col-md-4"><div class="card role-card h-100"><div class="card-body p-4">
        <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22V12M5 12c0-4 3-7 7-7s7 3 7 7"/><path d="M2 22h20"/></svg></div>
        <h2 class="h5">Farmer</h2>
        <p class="mb-0">Registers farms, fields and IoT devices, and records soil density, nutrients, humidity and drone images.</p>
    </div></div></div>
    <div class="col-md-4"><div class="card role-card h-100"><div class="card-body p-4">
        <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg></div>
        <h2 class="h5">Agronomist</h2>
        <p class="mb-0">Analyses the data farmers collect and makes crop health and yield recommendations.</p>
    </div></div></div>
    <div class="col-md-4"><div class="card role-card h-100"><div class="card-body p-4">
        <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></div>
        <h2 class="h5">Administrator</h2>
        <p class="mb-0">Manages users and their types, and assigns agronomists to farms.</p>
    </div></div></div>
</div>
